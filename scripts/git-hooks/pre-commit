#!/bin/sh
# Pre-commit guard: validate the knowledge-library before anything is committed.
#
# Installed locally only (see D10 in docs/architecture/decision-log.md: no CI, so
# every check must happen on this machine before changes reach the remote). The
# canonical copy lives at scripts/git-hooks/pre-commit; this file is a copy.
# Re-install with:  bash scripts/install-git-hooks.sh
#
# Scoped on purpose: it runs the knowledge-library validator, and only when the
# staged changes actually touch that directory, so it costs nothing (~250ms) on
# unrelated commits. It deliberately does not run pytest, pnpm, or ruff - those
# are slow and belong in explicit local runs, not in every commit.
#
# Bypass for a deliberate one-off:  git commit --no-verify
#
# It also carries a move guard (below): a staged deletion or rename that
# leaves references to the old path in the tree is blocked, naming the
# referencing files, for any file type -- not just docs.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# The installer may append a call to a pre-existing hook at the end of this file.
# Every exit below therefore goes through run_chained_hook, so a guard we did
# not write still runs. An early "exit 0" here would silently disable it.
chain_file="$(dirname "$0")/pre-commit.backup"
run_chained_hook() {
    if [ -f "$chain_file" ] && [ "$chain_file" != "$0" ]; then
        sh "$chain_file" "$@"
    fi
}


# ---------------------------------------------------------------------------
# Move guard: no staged deletion/rename may leave references behind.
#
# The check-all path-references gate (D39) catches stale references too,
# but only inside a triggered doc check and as a generic failure. This
# block runs on every commit, costs one git grep per moved path, and
# names the exact files still referencing the old path -- so the fix
# lands in the move commit itself instead of a follow-up.
#
# Exempt surfaces record old paths by design and mirror the D39
# checker's exclusions: CHANGELOG.md, docs/notes/, docs/scratch/, the
# decision log, and generated output/. References inside files that are
# themselves being deleted or renamed away die with them and do not
# count. Partially staged files are judged by their working-tree
# content, which is what git grep reads.
#
# Bypass for a deliberate one-off:  SKIP_MOVE_GUARD=1 git commit ...
# ---------------------------------------------------------------------------
if [ "${SKIP_MOVE_GUARD:-0}" != "1" ]; then
    guard_dir=$(git rev-parse --git-dir)
    moved_tmp=$(mktemp "$guard_dir/move-guard-moved.XXXXXX")
    hits_tmp=$(mktemp "$guard_dir/move-guard-hits.XXXXXX")
    git diff --cached --name-status | awk -F'\t' \
        '$1 == "D" {print $2} $1 ~ /^R/ {print $2}' > "$moved_tmp"
    if [ -s "$moved_tmp" ]; then
        while IFS= read -r old_path; do
            [ -n "$old_path" ] || continue
            old_bs=$(printf '%s' "$old_path" | sed 's|/|\\|g')
            git grep -F -n -e "$old_path" -e "$old_bs" -- . \
                ':(exclude)CHANGELOG.md' \
                ':(exclude)docs/notes/*' \
                ':(exclude)docs/scratch/*' \
                ':(exclude)docs/architecture/decision-log.md' \
                ':(exclude)output/*' 2>/dev/null \
            | while IFS= read -r hit_line; do
                hit_file=${hit_line%%:*}
                dying=0
                while IFS= read -r m; do
                    if [ "$hit_file" = "$m" ]; then dying=1; fi
                done < "$moved_tmp"
                if [ "$dying" -eq 0 ]; then
                    printf '%s\n' "$hit_line" >> "$hits_tmp"
                fi
            done
        done < "$moved_tmp"
    fi
    if [ -s "$hits_tmp" ]; then
        echo "pre-commit: move guard -- this commit deletes or renames a" >&2
        echo "file that other files still reference:" >&2
        echo >&2
        sed 's/^/    /' "$hits_tmp" >&2
        echo >&2
        echo "Update those references in this commit, or bypass once with" >&2
        echo "SKIP_MOVE_GUARD=1 (deliberate) or --no-verify." >&2
        rm -f "$moved_tmp" "$hits_tmp"
        exit 1
    fi
    rm -f "$moved_tmp" "$hits_tmp"
fi

# Which checks apply depends on what is staged: the library check only concerns
# docs/knowledge-library/, the map check only concerns the map and directories.
staged=$(git diff --cached --name-only)
need_lib=0
need_map=0
need_layout=0
need_encoding=0
for f in $staged; do
    case "$f" in
        docs/knowledge-library/*) need_lib=1 ;;
        docs/README.md|AGENTS.md)  need_map=1 ;;
        docs/*)                    need_map=1 ;;
    esac
done
# Encoding corruption is not confined to docs: a UTF-16 write or a truncated
# edit can hit any tracked text file, and the damage is invisible until a tool
# misreads it. Cheap enough (reads staged files only) to always run.
#
# Check each staged file individually: the old case-match on the whole $staged
# string matched any filename containing a dot, so it ran on nearly every
# commit and defeated the scoped design.
need_encoding=0
for f in $staged; do
    case "$f" in
        *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.py|*.md|*.json|*.yaml|*.yml|*.toml|*.ps1|*.sh|*.css|*.html|*.txt|*.cfg|*.ini)
            need_encoding=1
            ;;
    esac
done
# Layout hygiene only matters when tracked files are added or removed, or when
# the ignore rules change. Editing an existing file cannot introduce a new
# duplicate or a case collision, so ordinary commits skip this check.
if git diff --cached --name-only --diff-filter=ADR | grep -q . \
   || git diff --cached --name-only | grep -qE '\.(gitignore|gitattributes)$'; then
    need_layout=1
fi

if [ "$need_lib" -eq 0 ] && [ "$need_map" -eq 0 ] && [ "$need_layout" -eq 0 ] \
   && [ "$need_encoding" -eq 0 ]; then
    run_chained_hook "$@"
    exit 0
fi

# Resolve an interpreter: the studio env first, then anything on PATH.
PYTHON=""
for candidate in \
    "D:/conda-envs/nma-studio-cuda/Scripts/python.exe" \
    "venv/Scripts/python.exe"; do
    if [ -x "$candidate" ]; then
        PYTHON="$candidate"
        break
    fi
done
if [ -z "$PYTHON" ] && command -v python >/dev/null 2>&1; then
    PYTHON="python"
fi

if [ -z "$PYTHON" ]; then
    echo "pre-commit: no Python interpreter found; skipping doc checks." >&2
    echo "            Set one in scripts/git-hooks/pre-commit or install Python." >&2
    run_chained_hook "$@"
    exit 0
fi

# Run every doc/repo check in one command before committing by hand.
if [ "$need_lib" -eq 1 ] || [ "$need_map" -eq 1 ] || [ "$need_layout" -eq 1 ] \
   || [ "$need_encoding" -eq 1 ]; then
    if ! "$PYTHON" tools/check-all.py; then
        echo >&2
        echo "pre-commit: documentation checks failed (see above)." >&2
        echo "            Run 'python tools/check-all.py' for the full report," >&2
        echo "            or bypass once with --no-verify." >&2
        exit 1
    fi
    run_chained_hook "$@"
    exit 0
fi

run_chained_hook "$@"
exit 0
