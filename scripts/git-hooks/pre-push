#!/bin/sh
# Pre-push guard: the fast gates, before anything leaves the machine.
#
# Installed locally only (see D10 in docs/architecture/decision-log.md: no CI, so
# every check must happen here before changes reach the remote). The canonical
# copy lives at scripts/git-hooks/pre-push; this file is a copy.
# Re-install with:  bash scripts/install-git-hooks.sh
#
# Scope is deliberate. This runs what is cheap enough to run on every push:
# documentation/repo hygiene, backend lint, frontend type-check and lint, the
# fast vitest unit suite, and the tools' own unit tests (~4 s -- includes the
# exec-guard regression matrix, which protects every shell command). It does
# NOT run pytest (~40 s) or Playwright (~30 s) - those are what
# `python tools/run-gates.py --e2e` is for, and a push hook that takes 90 s gets
# bypassed, which is worse than no hook.
#
# The work happens in Python (tools/run-gates.py) rather than inline shell or
# PowerShell, for the reasons in AGENTS.md: a .ps1 wrapper can report exit 1
# while passing, and a pipe decoded as the ANSI code page mangles UTF-8 output.
# This file only decides *what* to run and *whether* to fail; it does not
# interpret tool output.
#
# Bypass for a deliberate one-off:  git push --no-verify

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Chain rather than replace. Git LFS installs its own pre-push hook, and
# overwriting it silently breaks large-file handling. install-git-hooks.sh keeps
# the displaced copy as pre-push.backup, and we call it at every exit path.
chain_file="$(dirname "$0")/pre-push.backup"
run_chained_hook() {
    if [ -f "$chain_file" ] && [ "$chain_file" != "$0" ]; then
        sh "$chain_file" "$@"
    fi
}

# Resolve an interpreter: the studio env first, then anything on PATH.
PYTHON=""
for candidate in \
    "D:/conda-envs/nma-studio-cuda/Scripts/python.exe" \
    "venv/Scripts/python.exe"; do
    if [ -x "$candidate" ]; then
        PYTHON="$candidate"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    for candidate in python python3; do
        if command -v "$candidate" >/dev/null 2>&1; then
            PYTHON="$candidate"
            break
        fi
    done
fi
if [ -z "$PYTHON" ]; then
    echo "pre-push: no Python interpreter found; skipping checks." >&2
    echo "            Set one in scripts/git-hooks/pre-push or install Python." >&2
    run_chained_hook "$@"
    exit 0
fi

# Determine the changed files in the unpushed batch. Prefer @{upstream}..HEAD
# (works regardless of default branch name); fall back to HEAD~1..HEAD if no
# upstream is configured. Pass the file list explicitly to --changed so
# run-gates.py scopes each gate to the files it cares about and caches PASS
# results by content hash — gates whose inputs haven't changed since a prior
# PASS are reported [CACHED] instead of re-executed.
changed_files=$(git diff --name-only @{upstream}..HEAD 2>/dev/null) || true
if [ -z "$changed_files" ]; then
    changed_files=$(git diff --name-only HEAD~1..HEAD 2>/dev/null) || true
fi

# The unit gate is ~1.5 s; tools-pytest is ~4 s; the rest are a few seconds each.
# pytest and Playwright are excluded on purpose (see the header).
# Changed file names are passed explicitly to --changed, so run-gates.py scopes
# each gate to the files it cares about (eslint/ruff only lint changed files;
# vitest only runs changed test files) and caches PASS results by content hash.
# Gates that cannot be affected by the unpushed batch are skipped entirely.
if [ -n "$changed_files" ]; then
    # shellcheck disable=SC2086: $changed_files is intentionally word-split
    # into individual path args; repo file paths contain no spaces.
    if ! "$PYTHON" tools/run-gates.py --only docs ruff type lint unit tools-pytest --changed $changed_files; then
        echo >&2
        echo "pre-push: fast gates failed (see above)." >&2
        echo "          Fix and push again, or bypass once with --no-verify." >&2
        echo "          Full suite: python tools/run-gates.py --e2e" >&2
        run_chained_hook "$@"
        exit 1
    fi
else
    echo "pre-push: no changed files detected; skipping gate run."
fi

# Attribution gate. commit-msg already rejects a trailerless commit at commit
# time on clones where it is installed, but a commit made on a clone without
# hooks, or one made with --no-verify, still must not ship unattributed: the
# agent-contribution report is the only channel that catches the whole unpushed
# batch (AGENTS.md, Attributing commits). Cheap: it reads trailer lines in the
# origin/main..HEAD range only.
if ! "$PYTHON" tools/agent-contribution-report.py --check; then
    echo >&2
    echo "pre-push: unattributed commit(s) ahead of origin/main (see above)." >&2
    echo "          Amend the named commit to end with its agent's" >&2
    echo "          Co-authored-by trailer, then push again; --no-verify bypasses." >&2
    run_chained_hook "$@"
    exit 1
fi

run_chained_hook "$@"
exit 0
