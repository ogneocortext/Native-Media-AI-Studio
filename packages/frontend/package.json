{
  "name": "native-media-ai-studio-frontend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "set NODE_OPTIONS=--max-old-space-size=4096 && vite",
    "dev:clean": "node packages/frontend/scripts/start-dev-server.ts --clean",
    "dev:force": "node packages/frontend/scripts/start-dev-server.ts --force-reoptimize",
    "dev:full-reset": "node packages/frontend/scripts/start-dev-server.ts --clean --force-reoptimize",
    "dev:ps": "pwsh -NoProfile -ExecutionPolicy Bypass -File packages/frontend/scripts/start-dev-server.ps1",
    "dev:ps:clean": "pwsh -NoProfile -ExecutionPolicy Bypass -File packages/frontend/scripts/start-dev-server.ps1 -Clean",
    "dev:ps:force": "pwsh -NoProfile -ExecutionPolicy Bypass -File packages/frontend/scripts/start-dev-server.ps1 -ForceReoptimize",
    "dev:ps:full-reset": "pwsh -NoProfile -ExecutionPolicy Bypass -File packages/frontend/scripts/start-dev-server.ps1 -Clean -ForceReoptimize",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b && tsc -p tsconfig.tests.json --noEmit",
    "type-check:app": "tsc -b",
    "type-check:tests": "tsc -p tsconfig.tests.json --noEmit",
    "type-check:ci": "tsc -b --extendedDiagnostics && tsc -p tsconfig.tests.json --noEmit --extendedDiagnostics",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:all": "vitest run && playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "clean": "node -e \"const fs=require('fs');['dist','node_modules/.vite'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "clean:all": "node -e \"const fs=require('fs');['dist','node_modules/.vite','.turbo'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@newkrok/three-particles": "^3.0.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "catalog:",
    "@remotion/cli": "catalog:",
    "@remotion/media": "catalog:",
    "@remotion/media-utils": "catalog:",
    "@remotion/renderer": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "0.7.2",
    "animejs": "^4.5.0",
    "axe-core": "^4.14.1",
    "lucide-react": "^1.53.0",
    "mediabunny": "^1.61.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "remotion": "catalog:",
    "three": "^0.186.1",
    "wavesurfer.js": "^8.1.0",
    "zod": "catalog:",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "catalog:",
    "@vitejs/devtools": "^0.8.3",
    "@vitejs/devtools-vitest": "^0.8.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright": "1.65.0-alpha-2026-10-28",
    "postcss-modules-values": "^4.0.0",
    "prettier": "catalog:",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "vite": "catalog:",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
