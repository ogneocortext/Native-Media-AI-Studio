{
  "name": "native-media-ai-studio-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "set NODE_OPTIONS=--max-old-space-size=4096 && vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b && tsc -p tsconfig.tests.json",
    "type-check:app": "tsc -b",
    "type-check:tests": "tsc -p tsconfig.tests.json",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:all": "vitest run && playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "clean": "node -e \"const fs=require('fs');['dist','node_modules/.vite'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\""
  },
  "dependencies": {
    "@newkrok/three-particles": "^3.0.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "catalog:",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "0.7.2",
    "animejs": "^4.5.0",
    "axe-core": "^4.14.0",
    "lucide-react": "^1.53.0",
    "mediabunny": "^1.61.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "wavesurfer.js": "^8.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/devtools": "^0.8.0",
    "@vitejs/devtools-vitest": "^0.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "playwright": "1.65.0-alpha-2026-10-28",
    "postcss-modules-values": "^4.0.0",
    "prettier": "3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tabler-react": "^1.30.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
