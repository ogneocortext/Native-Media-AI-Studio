# ============================================================================
# .npmrc — Native Media AI Studio
# ============================================================================
# This project uses pnpm as its package manager (see packageManager in
# package.json). npm may still be invoked indirectly (e.g. by Playwright's
# webServer), so only npm-compatible settings belong here. pnpm-specific
# settings (save-workspace-protocol, node-version, catalogs, etc.) live in
# pnpm-workspace.yaml.
# See https://docs.npmjs.com/cli/v11/using-npm/config/
# See https://pnpm.io/npmrc

# NOTE: pnpm reads ONLY registry/auth/TLS/proxy/local-address keys from
# .npmrc — engine-strict and save-exact below are inert for pnpm (they now
# live in pnpm-workspace.yaml as engineStrict/saveExact). They are kept
# for npm compatibility only; npm itself is blocked by the preinstall hook.

# Prevent accidental npm usage (project uses pnpm)
engine-strict=true

# Save exact versions (no caret/tilde) — valid for both npm and pnpm
save-exact=true

# Registry (override if using a private registry)
# registry=https://registry.npmjs.org/

# Auth tokens (set via pnpm login or CI secrets, not committed)
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}
