# ============================================================================
# .npmrc — Native Media AI Studio
# ============================================================================
# Only auth and registry settings are read from .npmrc files. All other
# settings (hoistPattern, nodeLinker, save-exact, etc.) live in
# pnpm-workspace.yaml.
# See https://pnpm.io/npmrc

# Prevent accidental npm usage (project uses pnpm)
engine-strict=true

# Save exact versions (no caret/tilde) — use with saveExact in workspace
save-exact=true

# Use `workspace:` protocol for workspace dependencies
save-workspace-protocol=true

# Pin Node.js version for pnpm operations
node-version=22.13.0

# Use pnpm's built-in package manager (not npm)
package-manager=true

# Registry (override if using a private registry)
# registry=https://registry.npmjs.org/

# Auth tokens (set via pnpm login or CI secrets, not committed)
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}
