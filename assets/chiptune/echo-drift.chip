# echo-drift - ambient pads + slow motif, C major, 96 BPM, SNES
# sparse enough that the SPC700 echo becomes the lead instrument
system snes
tempo 96
swing 0.52
vibrato lead 0.08 4.5

lead: E-5 - - - - - - - G-5 - - - - - - - | A-5 - - - - - - - G-5 - - - - - - - | F-5 - - - - - - - E-5 - - - - - - - | D-5 - - - - - - - E-5 - - - - - - - | E-5 - - - - - - - G-5 - - - - - - - | C-6 - - - - - - - A-5 - - - - - - - | G-5 - - - - - - - F-5 - - - - - - - | E-5 - - - - - - - D-5 - - - - - - -
