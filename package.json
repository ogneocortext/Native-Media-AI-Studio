{
  "name": "native-media-ai-studio",
  "version": "1.8.0",
  "private": true,
  "description": "Full-stack music-video creation suite with React/Vite frontend, FastAPI backend, and Unity/Blender/ComfyUI integrations",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.24.0"
  },
  "catalog": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "workspaces": [
    "packages/frontend",
    "packages/video-editor"
  ],
  "scripts": {
    "preinstall": "pnpm dlx -y only-allow pnpm",
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\start-studio.ps1",
    "dev:frontend": "pnpm --filter=native-media-ai-studio-frontend dev",
    "dev:backend": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\manage-servers.ps1 -Action start -Services backend",
    "dev:video": "pnpm --filter=video-editor dev",
    "dev:comfyui": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\manage-servers.ps1 -Action start -Services comfyui",
    "start": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\start-studio.ps1",
    "start:all": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\start-studio.ps1 -VideoEditor",
    "servers": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\manage-servers.ps1",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter=native-media-ai-studio-frontend build",
    "build:video": "pnpm --filter=video-editor build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "db:migrate": "cd packages/backend && D:\\conda-envs\\nma-studio-cuda\\Scripts\\python.exe -c \"from app.core.database import init_db; init_db()\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "turbo": "^2.10.12"
  }
}
