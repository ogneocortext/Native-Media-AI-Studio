{
  "name": "native-media-ai-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack music-video creation suite: React/Vite/TypeScript frontend, FastAPI backend, Unity/Blender/ComfyUI/Remotion integrations, and Go sidecars.",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "pnpm dlx -y only-allow@1.2.2 pnpm",
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\start-studio.ps1",
    "dev:frontend": "pnpm --filter=native-media-ai-studio-frontend dev",
    "dev:backend": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\manage-servers.ps1 -Action start -Services backend",
    "dev:video": "pnpm --filter=video-editor dev",
    "dev:comfyui": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\manage-servers.ps1 -Action start -Services comfyui",
    "start": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\start-studio.ps1",
    "start:all": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\start-studio.ps1 -VideoEditor",
    "servers": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts\\manage-servers.ps1",
    "build": "pnpm -r build",
    "type-check": "pnpm --filter=native-media-ai-studio-frontend type-check",
    "build:frontend": "pnpm --filter=native-media-ai-studio-frontend build",
    "build:video": "pnpm --filter=video-editor build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "verify": "python tools/run-gates.py",
    "verify:e2e": "python tools/run-gates.py --e2e",
    "clean": "pnpm -r clean",
    "db:migrate": "cd packages/backend && python -c \"from app.core.database import init_db; init_db()\""
  },
  "devDependencies": {
    "@playwright/mcp": "catalog:",
    "@playwright/test": "catalog:",
    "comfyui-mcp": "catalog:",
    "playwright": "catalog:",
    "postcss-modules-values": "^4.0.0",
    "sharp": "^0.35.5",
    "typescript": "catalog:",
    "@modelcontextprotocol/server": "^2.4.0"
  }
}