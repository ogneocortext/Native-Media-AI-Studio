  "usage_patterns": {
    "full_music_video_pipeline": {
      "description": "End-to-end music video creation using all MCP servers",
      "steps": [
        "1. Upload audio: POST /api/audio/analyze",
        "2. Get beat data: unity → get_beat_data",
        "3. Generate 3D scenes: blender → generate_3d_model or comfyui → txt2video",
        "4. Create animations: unity → create_beat_animation",
        "5. Capture frames: unity → capture_frame_sequence",
        "6. High-quality render: blender → render_animation (EEVEE Next)",
        "7. Composite: remotion → create_composition + render"
      ]
    },
    "quick_video_only": {
      "description": "Generate video without 3D pipeline",
      "steps": [
        "1. Upload audio: POST /api/audio/analyze",
        "2. Generate video: POST /api/video/generate-section",
        "3. Poll status: GET /api/jobs/{job_id}",
        "4. List outputs: GET /api/outputs"
      ]
    },
    "3d_rendering_only": {
      "description": "High-quality 3D render via Blender",
      "steps": [
        "1. Create scene: blender → create_cube/sphere/etc",
        "2. Set materials: blender → set_material_color",
        "3. Add lighting: blender → add_light",
        "4. Render: blender → render_image or render_animation"
      ]
    }
  }
