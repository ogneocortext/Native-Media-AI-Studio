{
  "title": "MCP Registry — Tool Inventories",
  "version": "2026-09-05",
  "description": "MCP server tool inventories with call signatures for AI agents. Each server is configured in opencode.json.",
  "servers": {
    "unity": {
      "command": "node tools/mcp/unity-mcp-bridge.mjs",
      "port": 7800,
      "protocol": "stdio → REST",
      "project_path": "unity-project-mcp",
      "description": "Unity 6000.x editor integration for 3D scene generation and beat-synced animation",
      "status_endpoint": "POST http://127.0.0.1:7800/api/exec with command: editor_status",
      "auth": "Bearer token from config/ports.json",
      "tools": {
        "scene_management": {
          "create_scene": {
            "params": {
              "path": "str"
            },
            "description": "Create a new Unity scene"
          },
          "editor_status": {
            "params": {},
            "description": "Get Unity Editor state (compiling, play mode, etc.)"
          }
        },
        "gameobjects": {
          "create_gameobject": {
            "params": {
              "name": "str",
              "primitive": "cube|sphere|capsule|cylinder|plane|quad (optional)"
            },
            "description": "Create a GameObject or primitive"
          },
          "add_component": {
            "params": {
              "target": "str",
              "type": "str"
            },
            "description": "Add component to a GameObject"
          }
        },
        "animation": {
          "create_animation_clip": {
            "params": {
              "path": "str",
              "frameRate": "int (default 24)",
              "loop": "bool (default false)"
            },
            "description": "Create an AnimationClip asset"
          },
          "create_animator_controller": {
            "params": {
              "path": "str"
            },
            "description": "Create an AnimatorController"
          },
          "add_animator_state": {
            "params": {
              "controller": "str",
              "layer": "int",
              "name": "str"
            },
            "description": "Add state to Animator"
          },
          "add_animator_transition": {
            "params": {
              "controller": "str",
              "layer": "int",
              "fromState": "str",
              "toState": "str"
            },
            "description": "Add transition between Animator states"
          },
          "create_beat_animation": {
            "params": {
              "object_name": "str",
              "clip_path": "str",
              "pulse_scale": "float (default 1.5)",
              "frame_rate": "int (default 24)",
              "max_beats": "int (optional)"
            },
            "description": "Create beat-synced AnimationClip using beat_data.json"
          },
          "get_beat_data": {
            "params": {},
            "description": "Read beat_data.json from Unity project (tempo, beat_times, keyframes)"
          }
        },
        "capture": {
          "capture_scene_view": {
            "params": {
              "save_path": "str",
              "width": "int (default 1280)",
              "height": "int (default 720)"
            },
            "description": "Capture Scene View to PNG"
          },
          "capture_game_view": {
            "params": {
              "save_path": "str",
              "width": "int",
              "height": "int"
            },
            "description": "Capture Game View"
          },
          "capture_frame_sequence": {
            "params": {
              "fps": "int (default 24)",
              "duration_seconds": "float (default 10)",
              "output_dir": "str (required)",
              "width": "int (default 1280)",
              "height": "int (default 720)"
            },
            "description": "Generate render commands for animation sequence"
          }
        },
        "build": {
          "build": {
            "params": {
              "target": "str",
              "outputPath": "str"
            },
            "description": "Build Unity project"
          },
          "create_prefab": {
            "params": {
              "source": "str",
              "path": "str"
            },
            "description": "Save GameObject as prefab"
          }
        },
        "advanced": {
          "bake_lighting": {
            "params": {
              "confirm": "bool"
            },
            "description": "Bake lightmaps"
          },
          "list_pipeline_commands": {
            "params": {},
            "description": "List all 100+ available commands"
          }
        }
      }
    },
