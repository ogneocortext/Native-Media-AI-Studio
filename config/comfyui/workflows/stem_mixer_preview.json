{
  "name": "Stem Mixer Preview",
  "description": "Preview stem mixes with visual feedback for remix creation",
  "version": "1.0.0",
  "format": "comfyui_api",
  "1": {
    "class_type": "LoadCheckpoint",
    "inputs": {
      "ckpt_name": "anime-diff-sd15.safetensors"
    }
  },
  "2": {
    "class_type": "NMARemixControllerNode",
    "inputs": {
      "layers": ["remix_layers", 0],
      "layer_index": 0,
      "gain_db": 0.0,
      "key_shift": 0.0,
      "crossfade": 0.0
    }
  },
  "3": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "remix preview, mashup visualization, blended styles",
      "clip": ["1", 1]
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 15,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.6,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["4", 1],
      "latent_image": ["3", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "NMA_remix_preview"
    }
  }
}
