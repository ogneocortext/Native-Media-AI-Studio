{
  "name": "Audio Reactive Visualizer",
  "description": "Generates audio-reactive visualizations from audio stems using ComfyUI",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "1",
      "type": "LoadCheckpoint",
      "inputs": {
        "ckpt_name": "anime-diff-sd15.safetensors"
      },
      "position": [0, 0]
    },
    {
      "id": "2",
      "type": "NMAAudioSyncNode",
      "inputs": {
        "audio_analysis": ["audio_analysis", 0],
        "section_index": 0,
        "beat_multiplier": 1.0
      },
      "position": [300, 0]
    },
    {
      "id": "3",
      "type": "EmptyLatentImage",
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      },
      "position": [0, 200]
    },
    {
      "id": "4",
      "type": "CLIPTextEncode",
      "inputs": {
        "text": "cinematic audio reactive visualization, beats synced, vibrant colors",
        "clip": ["1", 1]
      },
      "position": [0, 400]
    },
    {
      "id": "5",
      "type": "KSampler",
      "inputs": {
        "seed": 42,
        "steps": 20,
        "cfg": 7.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 0.8,
        "model": ["1", 0],
        "positive": ["4", 0],
        "negative": ["4", 1],
        "latent_image": ["3", 0]
      },
      "position": [300, 400]
    },
    {
      "id": "6",
      "type": "VAEDecode",
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 2]
      },
      "position": [600, 400]
    },
    {
      "id": "7",
      "type": "SaveImage",
      "inputs": {
        "images": ["6", 0],
        "filename_prefix": "NMA_audio_reactive"
      },
      "position": [900, 400]
    }
  ],
  "connections": [
    [["2", 0], ["5", 0]],
    [["1", 0], ["5", 0]],
    [["1", 2], ["5", 2]],
    [["3", 0], ["5", 3]],
    [["4", 0], ["5", 4]],
    [["4", 1], ["5", 5]],
    [["5", 0], ["6", 0]],
    [["1", 2], ["6", 1]],
    [["6", 0], ["7", 0]]
  ]
}