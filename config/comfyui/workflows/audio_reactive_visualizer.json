{
  "name": "Audio Reactive Visualizer",
  "description": "Audio-reactive visual generation synced to beat and spectrum",
  "version": "1.0.0",
  "format": "comfyui_api",
  "1": {
    "class_type": "LoadCheckpoint",
    "inputs": {
      "ckpt_name": "anime-diff-sd15.safetensors"
    }
  },
  "2": {
    "class_type": "NMAAudioSyncNode",
    "inputs": {
      "section_index": 0,
      "beat_multiplier": 1.0
    }
  },
  "3": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 576,
      "batch_size": 1
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "audio reactive visualizer, spectrum synced, dynamic lighting, motion graphics",
      "clip": ["1", 1]
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.65,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["4", 1],
      "latent_image": ["3", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "NMA_audio_visualizer"
    }
  }
}
