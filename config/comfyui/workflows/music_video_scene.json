{
  "name": "Music Video Scene",
  "description": "Full music video scene generation with camera moves and effects",
  "version": "1.0.0",
  "format": "comfyui_api",
  "1": {
    "class_type": "LoadCheckpoint",
    "inputs": {
      "ckpt_name": "anime-diff-sd15.safetensors"
    }
  },
  "2": {
    "class_type": "NMAAudioSyncNode",
    "inputs": {
      "audio_analysis": ["audio_analysis", 0],
      "section_index": 0,
      "beat_multiplier": 1.5
    }
  },
  "3": {
    "class_type": "NMAStemRouterNode",
    "inputs": {
      "stems": ["audio_stems", 0],
      "stem_type": "drums",
      "channel": "motion",
      "gain": 1.0
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 576,
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "cinematic music video scene, camera movement, dramatic lighting",
      "clip": ["1", 1]
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 25,
      "cfg": 8.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.7,
      "model": ["1", 0],
      "positive": ["5", 0],
      "negative": ["5", 1],
      "latent_image": ["4", 0]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "NMA_music_video"
    }
  }
}
