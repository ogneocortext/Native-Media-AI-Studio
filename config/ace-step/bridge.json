{
  "bridge": {
    "enabled": true,
    "service": "ace-step",
    "description": "ACE-Step bridge: isolates app code from ACE-Step provider API changes"
  },
  "service": {
    "base_url": "http://127.0.0.1:8201",
    "health_endpoint": "/health",
    "generate_endpoint": "/generate",
    "unload_endpoint": "/unload",
    "reload_endpoint": "/reload",
    "vram_endpoint": "/vram",
    "planning_style_endpoint": "/planning/style",
    "planning_lyrics_endpoint": "/planning/lyrics",
    "audio_endpoint": "/audio/{output_name}",
    "health_timeout": 5,
    "generate_timeout": 600,
    "unload_timeout": 10,
    "reload_timeout": 60
  },
  "version": {
    "tracked_ace_step_version": "1.5",
    "tracked_model_id": "acestep-v15-sft",
    "api_compatibility": "v1",
    "last_verified": null,
    "provider_update_detected": false
  },
  "compatibility": {
    "parameter_map": {
      "style": "captions",
      "lyrics": "lyrics",
      "cfg_scale": "guidance_scale",
      "inference_steps": "inference_steps",
      "seed": "seed",
      "output_name": "output_name"
    },
    "response_map": {
      "audio_path": "audio_path",
      "seed": "seed",
      "sample_rate": "sample_rate",
      "engine": "engine"
    },
    "unsupported_features": [
      "bf16_quantization",
      "triton_compile",
      "flash_attention"
    ],
    "required_env": [
      "TORCH_CUDA_ARCH_LIST=6.1",
      "PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128",
      "TORCHINDUCTOR_USE_TRITON=0",
      "ACESTEP_DTYPE=float32"
    ]
  },
  "startup": {
    "verify_on_start": true,
    "auto_detect_version": true,
    "warn_on_version_mismatch": true
  },
  "paths": {
    "server_script": "tools/music-gen/server.py",
    "venv_python": "tools/music-gen/ACE-Step-1.5/.venv/Scripts/python.exe",
    "output_dir": "output/music",
    "log_dir": "output/logs"
  }
}
