  "error_codes": {
    "E_ASSERT": {
      "class": "test-logic",
      "action": "Fix the assertion or the code under test, then rerun."
    },
    "E_ERROR": {
      "class": "test-logic",
      "action": "Read the stack trace — likely a bug in the code under test."
    },
    "E_TIMEOUT": {
      "class": "environment",
      "action": "Check service startup, machine load, and timeout budgets before touching test logic."
    },
    "E_ENV": {
      "class": "environment",
      "action": "Fix the missing service/file/dependency — the test itself is probably fine."
    },
    "E_SETUP": {
      "class": "test-infra",
      "action": "Failure happened in setup/fixture — inspect conftest and fixtures, not the test body."
    }
