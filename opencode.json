{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "snapshot": false,
  "mcp": {
    "ollama-tools": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp/ollama-tools-mcp.mjs"
      ],
      "environment": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "COMFYUI_URL": "http://127.0.0.1:8188",
        "BACKEND_URL": "http://127.0.0.1:8000"
      },
      "enabled": true
    },
    "vision": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp/vision-mcp.mjs"
      ],
      "environment": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "BACKEND_URL": "http://127.0.0.1:8000",
        "VISION_KEEP_ALIVE": "30m"
      },
      "enabled": true
    },
    "remotion-documentation": {
      "type": "local",
      "command": [
        "npx",
        "--no",
        "--offline",
        "@remotion/mcp@1.0.0"
      ],
      "enabled": true,
      "security_note": "Version-pinned MCP server. Pre-install with 'pnpm add -D @remotion/mcp@1.0.0' then run offline. See docs/knowledge-library/npx-best-practices-2026.md."
    },
    "comfyui": {
      "type": "local",
      "command": [
        "npx",
        "--no",
        "--offline",
        "comfyui-mcp@1.0.0",
        "--comfyui-url",
        "http://127.0.0.1:8188",
        "--force-remote"
      ],
      "enabled": true,
      "security_note": "Version-pinned MCP server. Pre-install with 'pnpm add -D comfyui-mcp@1.0.0' then run offline. See docs/knowledge-library/npx-best-practices-2026.md."
    },
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ],
      "environment": {
        "BLENDER_EXECUTABLE": "C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe"
      },
      "enabled": true
    },
    "unity": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp/unity-mcp-bridge.mjs"
      ],
      "environment": {
        "UNITY_PROJECT_PATH": "./unity-project-mcp"
      },
      "enabled": true
    },
    "hyperframes": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp/hyperframes-mcp.mjs"
      ],
      "environment": {
        "HYPERFRAMES_PROJECT": "tools/hyperframes-test"
      },
      "enabled": true
    }
  }
}
