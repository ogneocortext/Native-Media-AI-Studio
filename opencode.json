{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "snapshot": false,
  "mcp": {
    "remotion-documentation": {
      "type": "local",
      "command": ["npx", "-y", "@remotion/mcp@latest"],
      "enabled": true
    },
    "comfyui": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "comfyui-mcp",
        "--comfyui-url",
        "http://localhost:8188",
        "--force-remote"
      ],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": ["uvx", "blender-mcp"],
      "environment": {
        "BLENDER_EXECUTABLE": "C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe"
      },
      "enabled": true,
      "notes": "Update BLENDER_EXECUTABLE if Blender is installed elsewhere"
    },
    "unity": {
      "type": "local",
      "command": ["node", "tools/unity-mcp-bridge.mjs"],
      "environment": {
        "UNITY_PROJECT_PATH": "./unity-project-mcp"
      },
      "enabled": true,
      "notes": "UNITY_PROJECT_PATH is relative to project root"
    }
  }
}
