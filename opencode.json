{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "snapshot": false,
  "mcp": {
    "ollama-tools": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp/ollama-tools-mcp.mjs"
      ],
      "environment": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "COMFYUI_URL": "http://127.0.0.1:8188",
        "BACKEND_URL": "http://127.0.0.1:8000"
      },
      "enabled": true
    },
    "vision": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp/vision-mcp.mjs"
      ],
      "environment": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "BACKEND_URL": "http://127.0.0.1:8000"
      },
      "enabled": true
    },
    "remotion-documentation": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@remotion/mcp@latest"
      ],
      "enabled": true
    },
    "comfyui": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "comfyui-mcp",
        "--comfyui-url",
        "http://localhost:8188",
        "--force-remote"
      ],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ],
      "environment": {
        "BLENDER_EXECUTABLE": "C:\\Program Files\\Blender Foundation\\Blender 5.2\\blender.exe"
      },
      "enabled": true
    },
    "unity": {
      "type": "local",
      "command": [
        "node",
        "tools/mcp/unity-mcp-bridge.mjs"
      ],
      "environment": {
        "UNITY_PROJECT_PATH": "./unity-project-mcp"
      },
      "enabled": true
    }
  }
}
